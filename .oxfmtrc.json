{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 120,
	"singleQuote": true,
	"semi": true,
	"trailingComma": "all",
	"arrowParens": "always",
	"objectWrap": "preserve",
	"sortImports": false,
	"ignorePatterns": [
		"**/*.md",
		"**/*.json",
		"**/*.yml",
		"**/*.yaml",
		"demo/platforms/**",
		"demo/hooks/**",
		"src/platforms/**"
	]
}
