<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
  <ActionBar title="Waveform" flat="true" />

  <ScrollView>
    <StackLayout class="screen">

      <StackLayout class="hero">
        <Label text="{{ display_name }}" class="hero-name" />
        <Label text="{{ email }}" class="hero-email" />
        <Label text="Waveform Pro" class="badge" />
      </StackLayout>

      <Button text="Open the settings screen" tap="onOpenSettings" class="btn-primary" />
      <Label id="platformHint" class="hint" textWrap="true" />
      <Button text="Embed it in a page instead" tap="onOpenEmbedded" class="btn-ghost" ios:visibility="collapsed" />
      <Label ios:visibility="visible" android:visibility="collapsed" class="hint" textWrap="true" text="Android only: PreferencesView can host this same screen inside one of your own pages. iOS has no in-app equivalent, because Apple keeps app settings in the Settings app." />

      <Label text="Live values" class="section" />
      <StackLayout class="card">
        <GridLayout columns="*, auto" class="row">
          <Label col="0" text="Theme" class="row-title" />
          <Label col="1" text="{{ theme }}" class="row-value" />
        </GridLayout>
        <GridLayout columns="*, auto" class="row">
          <Label col="0" text="Accent" class="row-title" />
          <Label col="1" text="{{ accent }}" class="row-value" />
        </GridLayout>
        <GridLayout columns="*, auto" class="row">
          <Label col="0" text="Playback speed" class="row-title" />
          <Label col="1" text="{{ playback_speed }}" class="row-value" />
        </GridLayout>
        <GridLayout columns="*, auto" class="row">
          <Label col="0" text="Skip silence" class="row-title" />
          <Label col="1" text="{{ skip_silence ? 'on' : 'off' }}" class="row-value" />
        </GridLayout>
        <GridLayout columns="*, auto" class="row">
          <Label col="0" text="Notify me about" class="row-title" />
          <Label col="1" text="{{ notify_topics.length + ' topics' }}" class="row-value" />
        </GridLayout>
        <GridLayout columns="*, auto" class="row">
          <Label col="0" text="Storage limit" class="row-title" />
          <Label col="1" text="{{ storage_limit_gb + ' GB' }}" class="row-value" />
        </GridLayout>
        <GridLayout columns="*, auto" class="row -last">
          <Label col="0" text="Crash reports" class="row-title" />
          <Label col="1" text="{{ crash_reports ? 'on' : 'off' }}" class="row-value" />
        </GridLayout>
      </StackLayout>

      <Label text="Same store, your own controls" class="section" />
      <StackLayout class="card">
        <GridLayout columns="*, auto" class="row">
          <Label col="0" text="Compact rows" class="row-title" verticalAlignment="center" />
          <Switch col="1" checked="{{ compact_rows }}" />
        </GridLayout>
        <GridLayout columns="*, auto" class="row">
          <Label col="0" text="Play next automatically" class="row-title" verticalAlignment="center" textWrap="true" />
          <Switch col="1" checked="{{ continuous_play }}" />
        </GridLayout>
        <GridLayout columns="auto, *, auto" class="row -last">
          <Label col="0" text="Text size" class="row-title" verticalAlignment="center" />
          <Slider col="1" class="slider" minValue="12" maxValue="24" value="{{ text_size }}" />
          <Label col="2" text="{{ text_size }}" class="row-value" verticalAlignment="center" />
        </GridLayout>
      </StackLayout>

      <Label text="Last change" class="section" />
      <StackLayout class="card">
        <Label id="lastChange" text="Nothing yet — change something here or in the settings screen." class="log" textWrap="true" />
      </StackLayout>

      <Button text="Reset to defaults" tap="onReset" class="btn-ghost" />
      <Label text="Every control above and every row in the settings screen comes from one preferences.json." class="footnote" textWrap="true" />
    </StackLayout>
  </ScrollView>
</Page>
