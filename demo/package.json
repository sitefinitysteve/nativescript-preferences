{
  "name": "nativescript-preferences-demo",
  "main": "app/app.ts",
  "version": "2.0.0",
  "private": true,
  "description": "Demo app for nativescript-preferences",
  "license": "Apache-2.0",
  "scripts": {
    "generate": "node node_modules/nativescript-preferences/bin/ns-preferences.cjs generate",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "prebuild.android": "npm run generate",
    "build.android": "vite build -- --env.android",
    "prebuild.ios": "npm run generate",
    "build.ios": "vite build -- --env.ios"
  },
  "dependencies": {
    "@nativescript/core": "~9.1.0",
    "@nativescript/theme": "^3.1.0",
    "@valor/nativescript-websockets": "^2.0.2",
    "nativescript-preferences": "file:../src"
  },
  "devDependencies": {
    "@nativescript/android": "~9.1.0",
    "@nativescript/ios": "~9.1.0",
    "@nativescript/types": "~9.1.0",
    "@nativescript/vite": "~8.0.3",
    "typescript": "~6.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
