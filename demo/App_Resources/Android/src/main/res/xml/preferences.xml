<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="General">
        <EditTextPreference
            android:key="name_preference"
            android:title="Name"
            android:defaultValue=""
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="enabled_preference"
            android:title="Enabled"
            android:summary="Turns the thing on"
            android:defaultValue="true" />

        <ListPreference
            android:key="theme_preference"
            android:title="Theme"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:defaultValue="system"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            android:key="volume_preference"
            android:title="Volume"
            android:defaultValue="50"
            android:max="100"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceScreen
        android:key="advanced_screen"
        android:title="Advanced"
        android:summary="Diagnostics and privacy">
        <SwitchPreferenceCompat
            android:key="analytics_preference"
            android:title="Share anonymous analytics"
            android:defaultValue="false" />
    </PreferenceScreen>
</PreferenceScreen>
